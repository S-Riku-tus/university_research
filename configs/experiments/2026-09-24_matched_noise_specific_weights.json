{
  "purpose": "Matched-noise training with independently fitted models, preprocessing, epochs, and ensemble weights for each of seven noise conditions; paired comparison with the completed clean-only transfer run",
  "replicate_seeds": [42, 43, 44],
  "comparison_rule": "For each seed and SNR, train only on the matching 6/11 noise dataset. Recompute epoch selection and inner-holdout weights independently for that SNR, then evaluate once on the matching 6/18 noise dataset. Never choose weights from 6/18 labels.",
  "validation_override": {
    "run": {
      "smoke_test": false,
      "epochs": 200,
      "folds": 3,
      "random_seed": 42,
      "loop_parameter_sets": true
    },
    "data": {
      "experiment_names": null,
      "max_freq_hz_list": ["maxfreq=22kHz"],
      "noise_dir_names": [
        "heatflux_no_noise",
        "heatflux_reference_SNR=0",
        "heatflux_reference_SNR=-4",
        "heatflux_reference_SNR=-8",
        "heatflux_reference_SNR=-12",
        "heatflux_reference_SNR=-16",
        "heatflux_reference_SNR=-20"
      ],
      "data_source_dir_by_experiment": {
        "2025.06.11_0.3_2": "waterflow_20260817_1s",
        "2025.06.18_0.3_3": "waterflow_20260817_1s"
      },
      "skip_missing_datasets": false
    },
    "learning_policy": {
      "split_mode": "explicit_days",
      "train_experiments": ["2025.06.11_0.3_2"],
      "test_experiments": ["2025.06.18_0.3_3"],
      "internal_validation": "wav_kfold",
      "training_noise": "matched"
    },
    "acoustic_selection": {
      "enabled": false,
      "peak_height_threshold": null
    },
    "ensemble": {
      "enabled_strategy_names": ["simple_equal", "inner_holdout"]
    },
    "output": {
      "save_date": "20260924",
      "result_date_dir": "202609/24/matched_noise_specific_weights",
      "save_fold_predictions": true,
      "save_tuning_summary": true,
      "save_fitted_artifacts": false,
      "verify_reloaded_artifacts": false,
      "noise_trend_plots": {
        "enabled": true,
        "ensemble_strategy_names": ["simple_equal", "inner_holdout"],
        "metrics": ["r2", "roc_auc_cont"],
        "formats": ["png", "pdf"]
      }
    },
    "explainability": {"enabled": false}
  }
}
